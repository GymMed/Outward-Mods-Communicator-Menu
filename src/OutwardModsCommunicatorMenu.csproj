<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <OutputType>Library</OutputType>
        <LangVersion>9.0</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <DebugType>None</DebugType>
        <OutputPath>..\Release\</OutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>DEBUG</DefineConstants>
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="BepInEx.BaseLib" Version="5.4.16" />
        <PackageReference Include="HarmonyX" Version="2.5.7" />
        <PackageReference Include="Outward.GameLibs" Version="2022.5.18-r.0" />
        <PackageReference Include="Outward.ModsCommunicator" Version="1.2.0" />
        <PackageReference Include="Outward.SideLoader" Version="3.7.14" />
        <PackageReference Include="UnityEngine.Modules" Version="2020.3.26" />

      <Reference Include="UnityExplorer">
        <HintPath>Libraries\UnityExplorer.BIE5.Mono.dll</HintPath>
      </Reference>
      <Reference Include="UniverseLib">
        <HintPath>Libraries\UniverseLib.Mono.dll</HintPath>
      </Reference>
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Patches\" />
      <Folder Include="Utility\Exceptions\" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <Exec Command="call &quot;$(ProjectDir)..\Public\DontZip\placeBuild.bat&quot;" />
    </Target>
</Project>